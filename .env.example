# SPORE API base URL — used by src/lib/api.ts.
# Dev:  http://localhost:8042
# Prod: https://api.spore-research.com
NEXT_PUBLIC_API_URL=http://localhost:8042

# Absolute path to the SQLite file shared with the spore-api process.
# Required by src/lib/db.ts (server-only, opened readonly + query_only).
# Must point at the SAME file spore-api writes to (via aiosqlite),
# usually under spore-poc/data/.
SPORE_DB_PATH=/absolute/path/to/spore-poc/data/spore.db

# When SPORE_ADMIN_MODE=1, the Streamlit dashboard exposes the
# destructive admin operations. Default off.
# SPORE_ADMIN_MODE=1
